# Copy to .env; Docker Desktop must use Linux containers.
VDW_BIND_ADDRESS=127.0.0.1
VDW_PORT=8080
# Relative to compose.yaml. Windows accepts forward slashes, e.g. D:/datasets.
VDW_IMPORTS=./imports

# Optional build-only Debian mirror origin; empty keeps the base image's sources.
# Example: https://mirrors.tuna.tsinghua.edu.cn (no /debian suffix).
# Applies to both /debian and /debian-security; verify both from the build network.
VDW_DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
